# ── Notion Integration (optional) ──────────────────────────────────────────────
# Create an integration at https://www.notion.so/my-integrations
# then share your parent page with the integration.

NOTION_TOKEN=your_notion_integration_secret_here
NOTION_PARENT_PAGE_ID=your_notion_parent_page_id_here

# ── Ollama (required) ───────────────────────────────────────────────────────────
# Ollama runs locally — no key needed. Just make sure it's running:
#   ollama serve
# Default host is http://localhost:11434 (used automatically by LazyFlow).
